# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=design_platform
DB_USER=platform
DB_PASSWORD=platform_dev

# ── MinIO (S3 兼容) ──
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=platform-data
S3_REGION=us-east-1

# ── ChromaDB ──
CHROMADB_URL=http://chromadb:8000
CHROMADB_AUTH_CREDENTIALS=chroma:chromasecret

# ── AI Service (Python) ──
ENVIRONMENT=development
LOG_LEVEL=info
AI_SERVICE_PORT=8001
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT=30

CORS_ORIGIN=http://localhost:3000

# ── BFF (NestJS) ──
NODE_ENV=development
PORT=3001
CORE_SERVICE_URL=http://core-service:8080
AI_SERVICE_URL=http://ai-service:8001

# ── JWT ──
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── Core Service (Java) ──
SPRING_PROFILES_ACTIVE=docker
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── Deployment Profile（P0-1.1 测试环境分级）──
# 取值：local-dev | integration | staging | preprod | production
# - local-dev：本地开发，使用 docker/compose.yml（默认）
# - integration：CI 流水线，使用 docker/compose.yml + docker/compose.ci.yml
# - staging：Staging 环境，使用 docker/compose.yml + docker/compose.staging.yml
# - preprod：Preprod 环境，使用 docker/compose.yml + docker/compose.preprod.yml
# - production：生产环境，由运维单独管理
# 详细差异见 docs/TEST-ENVIRONMENTS.md
DEPLOYMENT_PROFILE=local-dev

# ── 测试运行 ID（P0-1.2 数据隔离，仅 CI 环境必填）──
# CI 流水线注入唯一标识（如 GitHub Actions run_id），用于标记测试数据便于清理
# 未设置时默认为 "untracked"，便于排查未标记的测试数据
TEST_RUN_ID=untracked

# ── 调度任务开关（A-64 Token 清理等，Staging/Preprod 必填 true）──
SCHEDULER_ENABLED=false

# ── 详细审计日志（D45 验收证据，Staging/Preprod 必填 true）──
AUDIT_LOG_DETAILED=false

# ── Token 自动过期清理调度（A-64，仅 Staging/Preprod 启用）──
TOKEN_CLEANUP_FIXED_DELAY_SECONDS=3600
TOKEN_CLEANUP_INITIAL_DELAY_SECONDS=60
TOKEN_CLEANUP_BATCH_SIZE=500

# ── Pact Broker（P0-1.3 契约测试基础设施，仅 CI 环境启用）──
# V1 策略：默认禁用（compose.ci.yml 中 pact-broker 使用 profiles: ["pact"]）
# 启用命令：docker compose -f docker/compose.yml -f docker/compose.ci.yml --profile pact up -d pact-broker
# V2 演进：基于 packages/shared/src/schemas/*.schema.ts 自动生成 Pact 契约文件并 push 到 Broker
PACT_BROKER_VERSION=2.111.0.1
PACT_BROKER_USERNAME=pact_ci
PACT_BROKER_PASSWORD=pact_ci_pass
PACT_BROKER_WRITE_USERNAME=pact_ci_writer
PACT_BROKER_WRITE_PASSWORD=pact_ci_writer_pass