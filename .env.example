# ===============================================
# 施工图全流程 AI 平台 - 环境变量模板
# 复制本文件为 .env 后修改本地值
# 命令：cp .env.example .env
# ===============================================
# ⚠️ 重要：本文件仅含变量名与默认值，禁止写入真实生产密钥
# ⚠️ 生产密钥须通过 KMS 注入，禁止硬编码或提交到 Git

# ── 数据库配置（PostgreSQL 16） ──
# 对应 docker/compose.yml 的 postgres 服务
DB_HOST=localhost
DB_PORT=5432
DB_NAME=design_platform
DB_USER=platform
DB_PASSWORD=platform_dev
# Java HikariCP 连接池（services/core/src/main/resources/application.yml）
DB_POOL_MAX=20
DB_POOL_MIN=5
# Python SQLAlchemy 连池（services/ai/src/config.py）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── 对象存储（MinIO / S3 兼容） ──
# 对应 docker/compose.yml 的 minio 服务
S3_ENDPOINT=http://localhost:9000
# 开发环境 MinIO 默认账号；生产环境须从 KMS 注入
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 默认 bucket（compose.yml 的 minio-init 会自动创建）
S3_BUCKET_NAME=design-platform
S3_REGION=us-east-1

# ── JWT / 认证 ──
# ⚠️ 必填：生产环境请使用至少 32 字符的强随机密钥
# 生成方式：openssl rand -base64 48
# docker compose 启动时若为空会直接拒绝启动（见 compose.yml JWT_SECRET:?）
JWT_SECRET=change-me-to-a-strong-random-secret-key-with-at-least-32-chars
# access token 有效期（建议 ≤15m，见 .trae/rules/security.md §2.2）
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# refresh token 有效期（建议 ≤7d，需支持 rotation）
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── AI Provider 配置（LLM） ──
# 留空时 AI 服务使用 Mock 模式（不调用付费 API）
# OD-05 决策：通用 LLM API 先行，建筑专业 AI 维持 ManualHandoff
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# AI 调用超时（秒），见 security.md §12
LLM_TIMEOUT=30

# ── 通用服务配置 ──
# 运行环境：development / staging / production
ENVIRONMENT=development
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# Node.js 进程环境（apps/web、apps/bff）
NODE_ENV=development
# Spring Boot 启动 profile（services/core）
# - default / dev：本地开发
# - docker：Docker Compose 启动（由 compose.yml 注入）
# - test：集成测试（由 AbstractIntegrationTest @ActiveProfiles 注入）
SPRING_PROFILES_ACTIVE=dev

# ── CORS 配置 ──
# 单一来源（Java / BFF 使用）：前端访问 BFF/Core 的来源
CORS_ORIGIN=http://localhost:3000
# 多来源列表（Python AI 服务使用，逗号分隔）
# 示例：http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# ── 服务端口约定（.trae/rules/devex.md §3.1） ──
# PostgreSQL       5432  postgres:16-alpine
# MinIO API        9000  minio/minio
# MinIO Console    9001  minio/minio
# Core Service     8080  Java Spring Boot（PORT 环境变量）
# AI Service       8000  Python FastAPI（uvicorn --port）
# BFF              3001  NestJS（PORT 环境变量）
# Web              3000  Next.js（next dev --port）
# 端口冲突检查：lsof -i:<port>
PORT=8080

# ── BFF 服务发现（apps/bff） ──
# BFF 转发请求到 Core/AI 服务（compose.yml 中以容器名引用）
CORE_SERVICE_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# ── Web 前端（apps/web） ──
# 客户端可访问的 BFF 地址（构建时注入）
NEXT_PUBLIC_BFF_URL=http://localhost:3001
# 服务端渲染时的 BFF 内部地址
BFF_URL=http://localhost:3001
