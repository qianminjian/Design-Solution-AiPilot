{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ]
  },
  "ignorePatterns": [
    ".next/",
    "node_modules/",
    "coverage/",
    "test-results/",
    "playwright-report/"
  ]
}
